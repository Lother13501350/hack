# Copy to .env.local and fill in. Never commit .env.local.
# After linking Vercel, `vercel env pull .env.local` syncs shared values for the whole team.

# AI (pick what the project needs)
# AI_GATEWAY_API_KEY=
# ANTHROPIC_API_KEY=

# Database / backend
# DATABASE_URL=

# OpenAI (issue #1). Without a key, every LLM route uses its template fallback.
OPENAI_API_KEY=
# Optional: defaults to https://api.openai.com/v1 (any OpenAI-compatible endpoint works)
OPENAI_BASE_URL=
# Optional: defaults to gpt-6-luna. /api/llm-ping reports whether the ID is valid.
OPENAI_MODEL=

# Sourcing (issue #4). Tavily web search key; without it the fixture is used.
SEARCH_API_KEY=
# Set to "fixture" to skip live search and LLM calls for sourcing.
DEMO_MODE=

# Outreach (issue #8). Comma-separated addresses that may receive demo emails.
OUTREACH_ALLOWLIST=
