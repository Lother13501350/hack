# Copy to .env.local and fill in. Never commit .env.local.
# After linking Vercel, `vercel env pull .env.local` syncs shared values for the whole team.

# AI (pick what the project needs)
# AI_GATEWAY_API_KEY=
# ANTHROPIC_API_KEY=

# Database / backend
# DATABASE_URL=

# GMI Cloud LLM (issue #1). Create the key at Console > Settings > API Key Management.
GMI_API_KEY=
# Optional: defaults to https://api.gmi-serving.com/v1
GMI_BASE_URL=
# Optional: defaults to Qwen/Qwen3.6-35B-A3B. Check /api/llm-ping for valid IDs.
GMI_MODEL=

# Sourcing (issue #4). Tavily web search key; without it the fixture is used.
SEARCH_API_KEY=
# Set to "fixture" to skip live search and LLM calls for sourcing.
DEMO_MODE=

# Outreach (issue #8). Comma-separated addresses that may receive demo emails.
OUTREACH_ALLOWLIST=
